+        busy_old_next: _,
+        stale_ctx: _,
+        ctx_keep: _,
         pending,
         alive,
         removed,
@@ -1075,6 +1078,9 @@ fn read_unit(r: &mut Reader) -> Result<Unit, SaveError> {
         target_tile: r.opt(|r| r.pair("ground target"))?,
         attack_tile: r.opt(|r| r.pair("ground attack"))?,
         busy: r.b()?,
+        busy_old_next: None,
+        stale_ctx: None,
+        ctx_keep: false,
