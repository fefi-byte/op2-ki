index 13b45be0..368b0ac0 100644
--- a/tools/crates/op2-sim/src/save.rs
+++ b/tools/crates/op2-sim/src/save.rs
@@ -544,6 +544,9 @@ fn write_unit(w: &mut Writer, u: &Unit) {
         target_tile,
         attack_tile,
