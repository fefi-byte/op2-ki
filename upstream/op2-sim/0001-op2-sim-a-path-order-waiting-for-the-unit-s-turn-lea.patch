@@ -639,7 +639,9 @@ impl Sim {
         // to the tile of its group's earlier Move).
         let u = &mut self.units[i];
         u.goal = Some(goal);
-        u.sidestep = None;
+        // A side-step in progress stays (path context waypoint -1): mp4_12 seed 3, Earthworker 53, pushed aside at
+        // 17028 (side tile 231,91), BuildWall at 17096 -- the original keeps wp -1 and, having arrived at 17204, goes
+        // back to the side tile instead of building.
         u.long_path.clear();
         u.path_range = beside.then_some((x, y, BESIDE, false));
         // The walk reads the request's found flag (+0x38, 0x40A10E): a search that doesn't reach the tile (or beside
